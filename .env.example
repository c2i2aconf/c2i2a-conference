# ── Database (Neon Postgres) ─────────────────────────────────────
# https://neon.tech → New Project → copy the pooled connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require

# ── Payload ──────────────────────────────────────────────────────
# Generate one: openssl rand -hex 32
PAYLOAD_SECRET=change-me

# ── Resend (transactional emails) ────────────────────────────────
# https://resend.com → API Keys. Leave empty to disable emails in dev
# (Payload then logs mail to the server console instead of sending).
RESEND_API_KEY=
# Resend only delivers from a domain verified in its dashboard (DNS records).
# Without one, use their test sender — it delivers ONLY to the email address
# of the Resend account that owns the API key:
EMAIL_FROM="C2I2A Conference <onboarding@resend.dev>"
EMAIL_FROM_NAME="C2I2A Conference"
# For real sending: add your domain at resend.com/domains, add the SPF/DKIM
# records it shows you, set EMAIL_FROM to that domain — and set the same
# three variables in your Vercel project (Production environment).

# ── Durable private uploads (provisioned by Vercel Blob) ─────────
BLOB_READ_WRITE_TOKEN=

# Set false for tests or when local schema changes are managed only by migrations
PAYLOAD_DB_PUSH=true

# ── App ──────────────────────────────────────────────────────────
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
